<Window x:Class="WinVCam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Camera" Width="900" Height="640" MinWidth="640" MinHeight="480"
        Background="#FF1E1E1E" Closing="Window_Closing" Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Preview of what is being published to the virtual camera -->
        <Border Grid.Row="0" CornerRadius="12" Background="#FF111111" ClipToBounds="True">
            <Grid>
                <Image x:Name="Preview" Stretch="Uniform"/>
                <TextBlock x:Name="PreviewHint" Text="No camera feed" Foreground="#FF888888"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Camera" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="CameraBox" Width="320" SelectionChanged="CameraBox_SelectionChanged"/>
            <Button Content="Refresh" Margin="8,0,0,0" Padding="12,4" Click="Refresh_Click"/>
            <Button x:Name="VCamButton" Content="Start virtual camera" Margin="16,0,0,0" Padding="14,4" Click="VCamButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,0" Foreground="#FFAAAAAA"
                   TextWrapping="Wrap" Text="Starting..."/>
    </Grid>
</Window>
